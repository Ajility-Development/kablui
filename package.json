{
  "name": "kablui",
  "version": "0.0.1",
  "description": "A UI component library for Vue",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/kablui.umd.cjs",
  "module": "./dist/kablui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kablui.js",
      "require": "./dist/kablui.umd.cjs"
    },
    "./style.css": "./dist/kablui.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.10"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "component-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajility/kablui.git"
  },
  "bugs": {
    "url": "https://github.com/ajility/kablui/issues"
  },
  "homepage": "https://github.com/ajility/kablui#readme"
}
